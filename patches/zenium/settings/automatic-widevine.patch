 namespace settings {
 
+namespace {
+
+constexpr base::FilePath::CharType kZeniumWidevineMarker[] =
+    FILE_PATH_LITERAL("zenium-imported-from-chrome");
+
+constexpr char kStatusEnabled[] = "enabled";
+constexpr char kStatusDisabled[] = "disabled";
+constexpr char kStatusNotFound[] = "notFound";
+constexpr char kStatusIncompatible[] = "incompatible";
+constexpr char kStatusCopyFailed[] = "copyFailed";
+constexpr char kStatusRemoveFailed[] = "removeFailed";
+
+// This deliberately lives only for the lifetime of the browser process. A
+// successful relaunch clears it, while navigating away from Settings does not.
+std::atomic_bool g_widevine_restart_required = false;
+
+struct WidevineCandidate {
+  base::FilePath path;
+  base::FilePath library_path;
+  base::Version version;
+};
+
+void AddVersionDirectories(const base::FilePath& root,
+                           std::vector<base::FilePath>* candidates,
+                           bool* found_any) {
+  if (!base::DirectoryExists(root)) {
+    return;
+  }
+
+  *found_any = true;
+  base::FileEnumerator directories(root, false,
+                                   base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = directories.Next(); !path.empty();
+       path = directories.Next()) {
+    candidates->push_back(path);
+  }
+}
+
+#if BUILDFLAG(IS_WIN)
+void AddApplicationVersionDirectories(const base::FilePath& application_root,
+                                      std::vector<base::FilePath>* candidates,
+                                      bool* found_any) {
+  if (!base::DirectoryExists(application_root)) {
+    return;
+  }
+
+  base::FileEnumerator versions(application_root, false,
+                                base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = versions.Next(); !path.empty();
+       path = versions.Next()) {
+    const base::FilePath widevine = path.AppendASCII(kWidevineCdmBaseDirectory);
+    if (base::DirectoryExists(widevine)) {
+      *found_any = true;
+      candidates->push_back(widevine);
+    }
+  }
+}
+#endif
+
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_MAC)
+void AddDirectCandidate(const base::FilePath& path,
+                        std::vector<base::FilePath>* candidates,
+                        bool* found_any) {
+  if (base::DirectoryExists(path)) {
+    *found_any = true;
+    candidates->push_back(path);
+  }
+}
+#endif
+
+std::vector<base::FilePath> GetChromeWidevineCandidates(bool* found_any) {
+  std::vector<base::FilePath> candidates;
+  *found_any = false;
+
+  base::FilePath chrome_user_data;
+  if (base::PathService::Get(chrome::DIR_CHROME_USER_DATA, &chrome_user_data)) {
+    AddVersionDirectories(
+        chrome_user_data.AppendASCII(kWidevineCdmBaseDirectory), &candidates,
+        found_any);
+
+#if BUILDFLAG(IS_LINUX)
+    for (const auto* channel : {
+             "google-chrome-beta",
+             "google-chrome-unstable",
+         }) {
+      AddVersionDirectories(
+          chrome_user_data.DirName().AppendASCII(channel).AppendASCII(
+              kWidevineCdmBaseDirectory),
+          &candidates, found_any);
+    }
+#elif BUILDFLAG(IS_MAC)
+    for (const auto* channel : {
+             "Chrome Beta",
+             "Chrome Canary",
+         }) {
+      AddVersionDirectories(
+          chrome_user_data.DirName().AppendASCII(channel).AppendASCII(
+              kWidevineCdmBaseDirectory),
+          &candidates, found_any);
+    }
+#elif BUILDFLAG(IS_WIN)
+    const base::FilePath google_data_root =
+        chrome_user_data.DirName().DirName();
+    for (const auto* channel : {
+             FILE_PATH_LITERAL("Chrome Beta"),
+             FILE_PATH_LITERAL("Chrome SxS"),
+         }) {
+      AddVersionDirectories(google_data_root.Append(channel)
+                                .Append(FILE_PATH_LITERAL("User Data"))
+                                .AppendASCII(kWidevineCdmBaseDirectory),
+                            &candidates, found_any);
+    }
+#endif
+  }
+
+#if BUILDFLAG(IS_LINUX)
+  for (const auto* path : {
+           "/opt/google/chrome/WidevineCdm",
+           "/opt/google/chrome-beta/WidevineCdm",
+           "/opt/google/chrome-unstable/WidevineCdm",
+       }) {
+    AddDirectCandidate(base::FilePath::FromUTF8Unsafe(path), &candidates,
+                       found_any);
+  }
+#elif BUILDFLAG(IS_MAC)
+  base::FilePath home;
+  base::PathService::Get(base::DIR_HOME, &home);
+  for (const auto* application : {
+           "Google Chrome.app",
+           "Google Chrome Beta.app",
+           "Google Chrome Canary.app",
+       }) {
+    const base::FilePath relative =
+        base::FilePath::FromUTF8Unsafe(application)
+            .Append("Contents")
+            .Append("Frameworks")
+            .Append("Google Chrome Framework.framework")
+            .Append("Versions")
+            .Append("Current")
+            .Append("Libraries")
+            .AppendASCII(kWidevineCdmBaseDirectory);
+    AddDirectCandidate(
+        base::FilePath(FILE_PATH_LITERAL("/Applications")).Append(relative),
+        &candidates, found_any);
+    if (!home.empty()) {
+      AddDirectCandidate(home.Append("Applications").Append(relative),
+                         &candidates, found_any);
+    }
+  }
+#elif BUILDFLAG(IS_WIN)
+  for (const int path_key : {
+           base::DIR_LOCAL_APP_DATA,
+           base::DIR_PROGRAM_FILES,
+           base::DIR_PROGRAM_FILESX86,
+       }) {
+    base::FilePath root;
+    if (!base::PathService::Get(path_key, &root)) {
+      continue;
+    }
+    for (const auto* product : {
+             FILE_PATH_LITERAL("Chrome"),
+             FILE_PATH_LITERAL("Chrome Beta"),
+             FILE_PATH_LITERAL("Chrome SxS"),
+         }) {
+      AddApplicationVersionDirectories(
+          root.Append(FILE_PATH_LITERAL("Google"))
+              .Append(product)
+              .Append(FILE_PATH_LITERAL("Application")),
+          &candidates, found_any);
+    }
+  }
+#endif
+
+  return candidates;
+}
+
+std::optional<WidevineCandidate> ValidateWidevineDirectory(
+    const base::FilePath& path) {
+  media::CdmCapability capability;
+  if (!ParseCdmManifestFromPath(path.Append(FILE_PATH_LITERAL("manifest.json")),
+                                &capability)) {
+    return std::nullopt;
+  }
+
+  const base::FilePath library_path =
+      media::GetPlatformSpecificDirectory(path).Append(
+          base::GetNativeLibraryName(kWidevineCdmLibraryName));
+  if (!base::PathExists(library_path)) {
+    return std::nullopt;
+  }
+
+  return WidevineCandidate{path, library_path, capability.version};
+}
+
+std::optional<WidevineCandidate> FindNewestCompatibleCandidate(
+    const std::vector<base::FilePath>& paths) {
+  std::optional<WidevineCandidate> newest;
+  for (const auto& path : paths) {
+    auto candidate = ValidateWidevineDirectory(path);
+    if (candidate && (!newest || candidate->version > newest->version)) {
+      newest = std::move(candidate);
+    }
+  }
+  return newest;
+}
+
+std::optional<WidevineCandidate> FindImportedWidevine(
+    base::FilePath* widevine_root) {
+  if (!base::PathService::Get(chrome::DIR_COMPONENT_UPDATED_WIDEVINE_CDM,
+                              widevine_root)) {
+    return std::nullopt;
+  }
+
+  std::vector<base::FilePath> imported_paths;
+  if (!base::DirectoryExists(*widevine_root)) {
+    return std::nullopt;
+  }
+
+  base::FileEnumerator directories(*widevine_root, false,
+                                   base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = directories.Next(); !path.empty();
+       path = directories.Next()) {
+    if (base::PathExists(path.Append(kZeniumWidevineMarker))) {
+      imported_paths.push_back(path);
+    }
+  }
+  return FindNewestCompatibleCandidate(imported_paths);
+}
+
+base::DictValue GetZeniumWidevineState() {
+  base::FilePath widevine_root;
+  auto imported = FindImportedWidevine(&widevine_root);
+
+  bool found_chrome_widevine = false;
+  auto chrome_widevine = FindNewestCompatibleCandidate(
+      GetChromeWidevineCandidates(&found_chrome_widevine));
+
+  base::DictValue state;
+  state.Set("enabled", imported.has_value());
+  state.Set("available", chrome_widevine.has_value());
+  state.Set("restartRequired", g_widevine_restart_required.load());
+  state.Set("version", imported ? imported->version.GetString() : "");
+
+  if (imported) {
+    state.Set("status", kStatusEnabled);
+  } else if (chrome_widevine) {
+    state.Set("status", kStatusDisabled);
+  } else if (found_chrome_widevine) {
+    state.Set("status", kStatusIncompatible);
+  } else {
+    state.Set("status", kStatusNotFound);
+  }
+  return state;
+}
+
+base::DictValue EnableZeniumWidevine() {
+  bool found_any = false;
+  auto source =
+      FindNewestCompatibleCandidate(GetChromeWidevineCandidates(&found_any));
+  if (!source) {
+    return GetZeniumWidevineState();
+  }
+
+  base::FilePath widevine_root;
+  if (!base::PathService::Get(chrome::DIR_COMPONENT_UPDATED_WIDEVINE_CDM,
+                              &widevine_root)) {
+    auto state = GetZeniumWidevineState();
+    state.Set("status", kStatusCopyFailed);
+    return state;
+  }
+
+  const base::FilePath install_dir =
+      widevine_root.AppendASCII(source->version.GetString());
+
+  if (!base::CreateDirectory(widevine_root)) {
+    auto state = GetZeniumWidevineState();
+    state.Set("status", kStatusCopyFailed);
+    return state;
+  }
+
+  // Build the new installation out of sight of component discovery. This
+  // prevents a failed or interrupted import from leaving a loadable partial
+  // component behind.
+  base::ScopedTempDir staging_dir;
+  if (!staging_dir.CreateUniqueTempDirUnderPath(
+          widevine_root, FILE_PATH_LITERAL(".zenium-widevine-"))) {
+    auto state = GetZeniumWidevineState();
+    state.Set("status", kStatusCopyFailed);
+    return state;
+  }
+
+  const base::FilePath staged_install_dir = staging_dir.GetPath();
+  const base::FilePath destination_library =
+      media::GetPlatformSpecificDirectory(staged_install_dir)
+          .Append(base::GetNativeLibraryName(kWidevineCdmLibraryName));
+  if (!base::CreateDirectory(destination_library.DirName()) ||
+      !base::CopyFile(
+          source->path.Append(FILE_PATH_LITERAL("manifest.json")),
+          staged_install_dir.Append(FILE_PATH_LITERAL("manifest.json"))) ||
+      !base::CopyFile(source->library_path, destination_library)) {
+    auto state = GetZeniumWidevineState();
+    state.Set("status", kStatusCopyFailed);
+    return state;
+  }
+
+  const base::FilePath source_license =
+      source->path.Append(FILE_PATH_LITERAL("LICENSE"));
+  if (base::PathExists(source_license)) {
+    base::CopyFile(source_license,
+                   staged_install_dir.Append(FILE_PATH_LITERAL("LICENSE")));
+  }
+
+  if (!ValidateWidevineDirectory(staged_install_dir) ||
+      !base::WriteFile(staged_install_dir.Append(kZeniumWidevineMarker),
+                       "Imported by Zenium\n")) {
+    auto state = GetZeniumWidevineState();
+    state.Set("status", kStatusCopyFailed);
+    return state;
+  }
+
+  // Never replace a component that Zenium does not own. It may have been
+  // installed by another component mechanism and disabling this setting must
+  // not remove it.
+  if (base::PathExists(install_dir)) {
+    if (!base::PathExists(install_dir.Append(kZeniumWidevineMarker)) ||
+        !base::DeletePathRecursively(install_dir)) {
+      auto state = GetZeniumWidevineState();
+      state.Set("status", kStatusCopyFailed);
+      return state;
+    }
+  }
+
+  if (!base::Move(staged_install_dir, install_dir)) {
+    auto state = GetZeniumWidevineState();
+    state.Set("status", kStatusCopyFailed);
+    return state;
+  }
+  staging_dir.Take();
+
+#if BUILDFLAG(IS_LINUX)
+  if (!UpdateWidevineCdmHintFile(install_dir, std::nullopt)) {
+    base::DeletePathRecursively(install_dir);
+    auto state = GetZeniumWidevineState();
+    state.Set("status", kStatusCopyFailed);
+    return state;
+  }
+#endif
+
+  g_widevine_restart_required.store(true);
+  return GetZeniumWidevineState();
+}
+
+base::DictValue DisableZeniumWidevine() {
+  base::FilePath widevine_root;
+  FindImportedWidevine(&widevine_root);
+  if (widevine_root.empty() || !base::DirectoryExists(widevine_root)) {
+    return GetZeniumWidevineState();
+  }
+
+  std::vector<base::FilePath> imported_paths;
+  base::FileEnumerator directories(widevine_root, false,
+                                   base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath path = directories.Next(); !path.empty();
+       path = directories.Next()) {
+    if (base::PathExists(path.Append(kZeniumWidevineMarker))) {
+      imported_paths.push_back(path);
+    }
+  }
+
+#if BUILDFLAG(IS_LINUX)
+  base::FilePath hinted_path = GetHintedWidevineCdmDirectory();
+  for (const auto& imported_path : imported_paths) {
+    if (hinted_path == imported_path) {
+      base::FilePath hint_file;
+      if (base::PathService::Get(chrome::FILE_COMPONENT_WIDEVINE_CDM_HINT,
+                                 &hint_file)) {
+        base::DeleteFile(hint_file);
+      }
+      break;
+    }
+  }
+#endif
+
+  bool success = true;
+  for (const auto& path : imported_paths) {
+    if (!widevine_root.IsParent(path) || !base::DeletePathRecursively(path)) {
+      success = false;
+    }
+  }
+
+  if (!imported_paths.empty()) {
+    g_widevine_restart_required.store(true);
+  }
+  auto state = GetZeniumWidevineState();
+  if (!success) {
+    state.Set("status", kStatusRemoveFailed);
+  }
+  return state;
+}
+
+base::DictValue SetZeniumWidevineEnabled(bool enabled) {
+  return enabled ? EnableZeniumWidevine() : DisableZeniumWidevine();
+}
