+void SystemHandler::HandleGetZeniumWidevineState(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 1u);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&GetZeniumWidevineState),
+      base::BindOnce(&SystemHandler::OnZeniumWidevineStateReady,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void SystemHandler::HandleSetZeniumWidevineEnabled(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2u);
+  CHECK(args[1].is_bool());
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&SetZeniumWidevineEnabled, args[1].GetBool()),
+      base::BindOnce(&SystemHandler::OnZeniumWidevineStateReady,
+                     weak_ptr_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void SystemHandler::OnZeniumWidevineStateReady(base::Value callback_id,
+                                               base::DictValue state) {
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(callback_id, std::move(state));
+  }
+}
