+// Copyright 2025 The Zenium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/zenium_services/schema.h"
+
+#include "components/zenium_services/zenium_services_helpers.h"
+#include "components/zenium_services/pref_names.h"
+#include "components/prefs/pref_service.h"
+
+namespace zenium {
+
+bool HasAcceptedSchema(const PrefService& prefs, int version) {
+  return prefs.GetBoolean(prefs::kZeniumDisableSchemaAlerts) ||
+         prefs.GetInteger(prefs::kZeniumSchemaVersion) >= version;
+}
+
+void AcceptCurrentSchema(PrefService& prefs) {
+  prefs.SetInteger(prefs::kZeniumSchemaVersion, kZeniumCurrentSchemaVersion);
+}
+
+bool ShouldShowSchemaNotification(const PrefService& prefs) {
+  return ShouldAccessServices(prefs) &&
+         !HasAcceptedSchema(prefs, kZeniumCurrentSchemaVersion);
+}
+
+ServicesChangelog& GetChangelog() {
+  static constexpr auto kZeniumSchemaChangelog =
+      base::MakeFixedFlatMap<int, std::string_view>({
+          {
+            1,
+            "Automatic component updates are now available. They're managed by the same toggle that enables automatic browser updates.\n"
+            "From now on, you'll be notified about major changes to Zenium services. Even though these notifications are extremely rare, you can choose to ignore them and accept all future changes automatically."
+          }
+      });
+
+  return kZeniumSchemaChangelog;
+}
+
+}  // namespace zenium
