 }
 
+void OmniboxPopupViewFullWebUI::BeginZeniumNewTab() {
+  // A new palette session is a meaningful state transition even when its
+  // empty text, selection, and focus happen to match the previous session.
+  // Clearing the deduplication cache also covers a preloaded WebUI whose
+  // handler is not attached yet: its subsequent native-state request will
+  // deliver the new session because these values remain unset.
+  last_sent_text_.reset();
+  last_sent_focus_.reset();
+  SyncNativeStateToWebUI();
+}
