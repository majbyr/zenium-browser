diff --git a/chrome/browser/ui/omnibox/chrome_omnibox_client.cc b/chrome/browser/ui/omnibox/chrome_omnibox_client.cc
--- a/chrome/browser/ui/omnibox/chrome_omnibox_client.cc
+++ b/chrome/browser/ui/omnibox/chrome_omnibox_client.cc
@@ -214,6 +214,16 @@ bool ChromeOmniboxClient::CurrentPageExists() const {
 }
 
 const GURL& ChromeOmniboxClient::GetURL() const {
+  if (browser_) {
+    BrowserView* browser_view =
+        BrowserView::GetBrowserViewForBrowser(browser_);
+    if (browser_view && browser_view->IsZeniumNewTabOmniboxActive()) {
+      // The centered New Tab palette is not editing the active tab. Keep its
+      // zero-prefix request independent of chrome://newtab so local
+      // most-visited suggestions are eligible on the very first invocation.
+      return GURL::EmptyGURL();
+    }
+  }
   return CurrentPageExists() ? location_bar_->GetWebContents()->GetVisibleURL()
                              : GURL::EmptyGURL();
 }
@@ -440,6 +450,17 @@ GURL ChromeOmniboxClient::GetContextualTasksInnerFrameURL() const {
 
 metrics::OmniboxEventProto::PageClassification
 ChromeOmniboxClient::GetPageClassification(bool is_prefetch) const {
+  if (browser_) {
+    BrowserView* browser_view =
+        BrowserView::GetBrowserViewForBrowser(browser_);
+    if (browser_view && browser_view->IsZeniumNewTabOmniboxActive()) {
+      // This is a browser-owned navigation surface rather than the NTP's
+      // inline omnibox. OTHER enables the desktop on-focus URL provider;
+      // NTP classifications intentionally suppress that provider upstream.
+      return is_prefetch ? metrics::OmniboxEventProto::OTHER_ZPS_PREFETCH
+                         : metrics::OmniboxEventProto::OTHER;
+    }
+  }
   return location_bar_->GetLocationBarModel()->GetPageClassification(
       is_prefetch);
 }
