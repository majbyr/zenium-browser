+BubbleBorder::Arrow AlignBubbleArrowHorizontally(
+    BubbleBorder::Arrow arrow,
+    bool align_left) {
+  if (align_left) {
+    switch (arrow) {
+      case BubbleBorder::TOP_RIGHT:
+        return BubbleBorder::TOP_LEFT;
+      case BubbleBorder::BOTTOM_RIGHT:
+        return BubbleBorder::BOTTOM_LEFT;
+      case BubbleBorder::RIGHT_TOP:
+        return BubbleBorder::LEFT_TOP;
+      case BubbleBorder::RIGHT_BOTTOM:
+        return BubbleBorder::LEFT_BOTTOM;
+      case BubbleBorder::RIGHT_CENTER:
+        return BubbleBorder::LEFT_CENTER;
+      default:
+        return arrow;
+    }
+  }
+
+  switch (arrow) {
+    case BubbleBorder::TOP_LEFT:
+      return BubbleBorder::TOP_RIGHT;
+    case BubbleBorder::BOTTOM_LEFT:
+      return BubbleBorder::BOTTOM_RIGHT;
+    case BubbleBorder::LEFT_TOP:
+      return BubbleBorder::RIGHT_TOP;
+    case BubbleBorder::LEFT_BOTTOM:
+      return BubbleBorder::RIGHT_BOTTOM;
+    case BubbleBorder::LEFT_CENTER:
+      return BubbleBorder::RIGHT_CENTER;
+    default:
+      return arrow;
+  }
+}
+
+void ApplyAnchorRequestedBubbleAlignment(BubbleDialogDelegate* delegate) {
+  const std::optional<bool> align_left =
+      GetBubbleAnchorLeftAlignment(delegate->GetAnchorView());
+  if (!align_left) {
+    return;
+  }
+
+  BubbleBorder::Arrow arrow =
+      AlignBubbleArrowHorizontally(delegate->arrow(), *align_left);
+  // SetArrowWithoutResizing() accepts logical arrows, while arrow() is already
+  // mirrored. Convert the physical result back in RTL locales.
+  if (base::i18n::IsRTL()) {
+    arrow = BubbleBorder::horizontal_mirror(arrow);
+  }
+  delegate->SetArrowWithoutResizing(arrow);
+}
