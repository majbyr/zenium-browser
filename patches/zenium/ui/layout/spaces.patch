+// Copyright 2026 The Zenium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_ZENIUM_SPACE_CONTROLLER_H_
+#define CHROME_BROWSER_UI_TABS_ZENIUM_SPACE_CONTROLLER_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+
+class Browser;
+class TabStripModel;
+
+namespace tabs {
+class TabInterface;
+
+// Window-scoped controller for Zenium Spaces. Space definitions and the last
+// active Space are profile preferences, while each tab keeps its own stable
+// membership in session data.
+class ZeniumSpaceController : public TabStripModelObserver {
+ public:
+  struct Space {
+    std::string id;
+    std::u16string name;
+  };
+
+  explicit ZeniumSpaceController(Browser* browser);
+  ZeniumSpaceController(const ZeniumSpaceController&) = delete;
+  ZeniumSpaceController& operator=(const ZeniumSpaceController&) = delete;
+  ~ZeniumSpaceController() override;
+
+  const std::vector<Space>& spaces() const { return spaces_; }
+  const std::string& active_space_id() const { return active_space_id_; }
+  TabStripModel* tab_strip_model() const { return tab_strip_model_; }
+
+  bool IsTabVisible(const TabInterface* tab) const;
+  void SwitchToSpace(const std::string& space_id);
+  std::string CreateSpace();
+  void RenameSpace(const std::string& space_id, const std::u16string& name);
+  void DeleteSpace(const std::string& space_id);
+  void MoveTabToSpace(TabInterface* tab, const std::string& space_id);
+
+  base::CallbackListSubscription RegisterChangedCallback(
+      base::RepeatingClosure callback);
+
+  base::WeakPtr<ZeniumSpaceController> GetWeakPtr();
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(TabInterface* tab, int index) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+ private:
+  void LoadSpaces();
+  void SaveSpaces();
+  void AssignMissingTabs();
+  void ActivateSpaceTab();
+  bool HasSpace(const std::string& space_id) const;
+  std::string SpaceIdForTab(const TabInterface* tab) const;
+  void NotifyChanged();
+
+  raw_ptr<Browser> browser_ = nullptr;
+  raw_ptr<TabStripModel> tab_strip_model_ = nullptr;
+  std::vector<Space> spaces_;
+  std::string active_space_id_;
+  std::map<std::string, base::WeakPtr<TabInterface>> last_active_tabs_;
+  base::RepeatingClosureList changed_callbacks_;
+  bool switching_space_ = false;
+
+  base::WeakPtrFactory<ZeniumSpaceController> weak_factory_{this};
+};
+
+}  // namespace tabs
+
+#endif  // CHROME_BROWSER_UI_TABS_ZENIUM_SPACE_CONTROLLER_H_
