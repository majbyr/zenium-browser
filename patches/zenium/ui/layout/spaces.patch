+// Copyright 2026 The Zenium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/zenium_space_tab_data.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tabs {
+
+namespace {
+
+constexpr char kZeniumSpaceIdKey[] = "zenium.space_id";
+
+}  // namespace
+
+ZeniumSpaceTabData::ZeniumSpaceTabData(content::WebContents* web_contents,
+                                       const std::string& space_id)
+    : content::WebContentsUserData<ZeniumSpaceTabData>(*web_contents),
+      space_id_(space_id) {}
+
+ZeniumSpaceTabData::~ZeniumSpaceTabData() = default;
+
+// static
+std::string ZeniumSpaceTabData::GetSpaceId(content::WebContents* web_contents) {
+  auto* data = FromWebContents(web_contents);
+  return data ? data->space_id_ : std::string();
+}
+
+// static
+void ZeniumSpaceTabData::SetSpaceId(content::WebContents* web_contents,
+                                    const std::string& space_id) {
+  if (!web_contents || space_id.empty()) {
+    return;
+  }
+
+  auto* data = FromWebContents(web_contents);
+  if (!data) {
+    CreateForWebContents(web_contents, space_id);
+    data = FromWebContents(web_contents);
+  } else if (data->space_id_ == space_id) {
+    return;
+  } else {
+    data->space_id_ = space_id;
+  }
+  data->Persist();
+}
+
+// static
+void ZeniumSpaceTabData::PopulateExtraData(
+    content::WebContents* web_contents,
+    std::map<std::string, std::string>* extra_data) {
+  if (auto* data = FromWebContents(web_contents); data && extra_data) {
+    (*extra_data)[kZeniumSpaceIdKey] = data->space_id_;
+  }
+}
+
+// static
+void ZeniumSpaceTabData::RestoreFromExtraData(
+    content::WebContents* web_contents,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kZeniumSpaceIdKey);
+  if (it != extra_data.end() && !it->second.empty()) {
+    CreateForWebContents(web_contents, it->second);
+  }
+}
+
+void ZeniumSpaceTabData::Persist() {
+  Profile* profile =
+      Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+  SessionService* session_service =
+      SessionServiceFactory::GetForProfile(profile);
+  if (!session_service) {
+    return;
+  }
+
+  session_service->AddTabExtraData(
+      sessions::SessionTabHelper::IdForWindowContainingTab(&GetWebContents()),
+      sessions::SessionTabHelper::IdForTab(&GetWebContents()),
+      kZeniumSpaceIdKey, space_id_);
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ZeniumSpaceTabData);
+
+}  // namespace tabs
