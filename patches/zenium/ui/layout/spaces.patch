diff --git a/chrome/browser/ui/tabs/zenium_space_controller.cc b/chrome/browser/ui/tabs/zenium_space_controller.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/tabs/zenium_space_controller.cc
@@ -0,0 +1,291 @@
+// Copyright 2026 The Zenium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/zenium_space_controller.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/zenium_space_tab_data.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tabs {
+
+namespace {
+
+constexpr char kSpaceIdKey[] = "id";
+constexpr char kSpaceNameKey[] = "name";
+
+}  // namespace
+
+ZeniumSpaceController::ZeniumSpaceController(Browser* browser)
+    : browser_(browser), tab_strip_model_(browser->tab_strip_model()) {
+  LoadSpaces();
+  tab_strip_model_->AddObserver(this);
+  AssignMissingTabs();
+
+  if (TabInterface* active_tab = tab_strip_model_->GetActiveTab();
+      active_tab && !active_tab->IsPinned()) {
+    const std::string active_tab_space = SpaceIdForTab(active_tab);
+    if (HasSpace(active_tab_space)) {
+      active_space_id_ = active_tab_space;
+      browser_->profile()->GetPrefs()->SetString(prefs::kZeniumActiveSpace,
+                                                 active_space_id_);
+    }
+  }
+}
+
+ZeniumSpaceController::~ZeniumSpaceController() {
+  if (tab_strip_model_) {
+    tab_strip_model_->RemoveObserver(this);
+  }
+}
+
+bool ZeniumSpaceController::IsTabVisible(const TabInterface* tab) const {
+  return tab && (tab->IsPinned() || SpaceIdForTab(tab) == active_space_id_);
+}
+
+void ZeniumSpaceController::SwitchToSpace(const std::string& space_id) {
+  if (!HasSpace(space_id) || space_id == active_space_id_) {
+    return;
+  }
+
+  if (TabInterface* active_tab = tab_strip_model_->GetActiveTab();
+      active_tab && !active_tab->IsPinned()) {
+    last_active_tabs_[active_space_id_] = active_tab->GetWeakPtr();
+  }
+
+  switching_space_ = true;
+  active_space_id_ = space_id;
+  browser_->profile()->GetPrefs()->SetString(prefs::kZeniumActiveSpace,
+                                             active_space_id_);
+  ActivateSpaceTab();
+  switching_space_ = false;
+  NotifyChanged();
+}
+
+std::string ZeniumSpaceController::CreateSpace() {
+  Space space;
+  space.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  space.name = u"Space " + base::NumberToString16(spaces_.size() + 1);
+  spaces_.push_back(space);
+  SaveSpaces();
+  SwitchToSpace(space.id);
+  return space.id;
+}
+
+void ZeniumSpaceController::RenameSpace(const std::string& space_id,
+                                        const std::u16string& name) {
+  if (name.empty()) {
+    return;
+  }
+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  if (it == spaces_.end() || it->name == name) {
+    return;
+  }
+  it->name = name;
+  SaveSpaces();
+  NotifyChanged();
+}
+
+void ZeniumSpaceController::DeleteSpace(const std::string& space_id) {
+  if (spaces_.size() <= 1) {
+    return;
+  }
+  auto it = std::ranges::find(spaces_, space_id, &Space::id);
+  if (it == spaces_.end()) {
+    return;
+  }
+
+  const size_t deleted_index = std::distance(spaces_.begin(), it);
+  const std::string fallback_id =
+      deleted_index == 0 ? spaces_[1].id : spaces_[deleted_index - 1].id;
+  for (int index = 0; index < tab_strip_model_->count(); ++index) {
+    TabInterface* tab = tab_strip_model_->GetTabAtIndex(index);
+    if (!tab->IsPinned() && SpaceIdForTab(tab) == space_id) {
+      ZeniumSpaceTabData::SetSpaceId(tab->GetContents(), fallback_id);
+    }
+  }
+
+  spaces_.erase(it);
+  last_active_tabs_.erase(space_id);
+  SaveSpaces();
+  if (active_space_id_ == space_id) {
+    active_space_id_ = fallback_id;
+    browser_->profile()->GetPrefs()->SetString(prefs::kZeniumActiveSpace,
+                                               active_space_id_);
+    ActivateSpaceTab();
+  }
+  NotifyChanged();
+}
+
+void ZeniumSpaceController::MoveTabToSpace(TabInterface* tab,
+                                           const std::string& space_id) {
+  if (!tab || tab->IsPinned() || !HasSpace(space_id)) {
+    return;
+  }
+  ZeniumSpaceTabData::SetSpaceId(tab->GetContents(), space_id);
+  if (tab->IsActivated() && space_id != active_space_id_) {
+    SwitchToSpace(space_id);
+    return;
+  }
+  NotifyChanged();
+}
+
+base::CallbackListSubscription ZeniumSpaceController::RegisterChangedCallback(
+    base::RepeatingClosure callback) {
+  return changed_callbacks_.Add(std::move(callback));
+}
+
+base::WeakPtr<ZeniumSpaceController> ZeniumSpaceController::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void ZeniumSpaceController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::Type::kInserted) {
+    const auto* insert = change.GetInsert();
+    for (const auto& item : insert->contents) {
+      if (!item.tab->IsPinned() && SpaceIdForTab(item.tab).empty()) {
+        ZeniumSpaceTabData::SetSpaceId(item.contents, active_space_id_);
+      }
+    }
+  } else if (change.type() == TabStripModelChange::Type::kReplaced) {
+    const auto* replace = change.GetReplace();
+    const std::string old_space =
+        ZeniumSpaceTabData::GetSpaceId(replace->old_contents);
+    if (!old_space.empty() &&
+        ZeniumSpaceTabData::GetSpaceId(replace->new_contents).empty()) {
+      ZeniumSpaceTabData::SetSpaceId(replace->new_contents, old_space);
+    }
+  }
+
+  if (!switching_space_ && selection.active_tab_changed() &&
+      selection.new_tab && !selection.new_tab->IsPinned()) {
+    const std::string selected_space = SpaceIdForTab(selection.new_tab);
+    if (HasSpace(selected_space) && selected_space != active_space_id_) {
+      active_space_id_ = selected_space;
+      browser_->profile()->GetPrefs()->SetString(prefs::kZeniumActiveSpace,
+                                                 active_space_id_);
+    }
+    last_active_tabs_[active_space_id_] = selection.new_tab->GetWeakPtr();
+  }
+  NotifyChanged();
+}
+
+void ZeniumSpaceController::OnTabPinnedStateChanged(TabInterface* tab,
+                                                    int index) {
+  if (!tab->IsPinned() && SpaceIdForTab(tab).empty()) {
+    ZeniumSpaceTabData::SetSpaceId(tab->GetContents(), active_space_id_);
+  }
+  NotifyChanged();
+}
+
+void ZeniumSpaceController::OnTabStripModelDestroyed(
+    TabStripModel* tab_strip_model) {
+  tab_strip_model_ = nullptr;
+}
+
+void ZeniumSpaceController::LoadSpaces() {
+  PrefService* prefs_service = browser_->profile()->GetPrefs();
+  for (const base::Value& value :
+       prefs_service->GetList(prefs::kZeniumSpaces)) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* id = dict->FindString(kSpaceIdKey);
+    const std::string* name = dict->FindString(kSpaceNameKey);
+    if (id && name && !id->empty() && !name->empty() && !HasSpace(*id)) {
+      spaces_.push_back({*id, base::UTF8ToUTF16(*name)});
+    }
+  }
+
+  if (spaces_.empty()) {
+    spaces_.push_back(
+        {base::Uuid::GenerateRandomV4().AsLowercaseString(), u"Personal"});
+    SaveSpaces();
+  }
+
+  active_space_id_ = prefs_service->GetString(prefs::kZeniumActiveSpace);
+  if (!HasSpace(active_space_id_)) {
+    active_space_id_ = spaces_.front().id;
+    prefs_service->SetString(prefs::kZeniumActiveSpace, active_space_id_);
+  }
+}
+
+void ZeniumSpaceController::SaveSpaces() {
+  base::ListValue list;
+  for (const Space& space : spaces_) {
+    base::DictValue dict;
+    dict.Set(kSpaceIdKey, space.id);
+    dict.Set(kSpaceNameKey, base::UTF16ToUTF8(space.name));
+    list.Append(std::move(dict));
+  }
+  browser_->profile()->GetPrefs()->SetList(prefs::kZeniumSpaces,
+                                           std::move(list));
+}
+
+void ZeniumSpaceController::AssignMissingTabs() {
+  for (int index = 0; index < tab_strip_model_->count(); ++index) {
+    TabInterface* tab = tab_strip_model_->GetTabAtIndex(index);
+    if (!tab->IsPinned() && SpaceIdForTab(tab).empty()) {
+      ZeniumSpaceTabData::SetSpaceId(tab->GetContents(), active_space_id_);
+    }
+  }
+}
+
+void ZeniumSpaceController::ActivateSpaceTab() {
+  auto last_it = last_active_tabs_.find(active_space_id_);
+  if (last_it != last_active_tabs_.end() && last_it->second) {
+    const int index = tab_strip_model_->GetIndexOfTab(last_it->second.get());
+    if (index != TabStripModel::kNoTab && IsTabVisible(last_it->second.get())) {
+      tab_strip_model_->ActivateTabAt(index);
+      return;
+    }
+  }
+
+  for (int index = 0; index < tab_strip_model_->count(); ++index) {
+    TabInterface* tab = tab_strip_model_->GetTabAtIndex(index);
+    if (!tab->IsPinned() && IsTabVisible(tab)) {
+      last_active_tabs_[active_space_id_] = tab->GetWeakPtr();
+      tab_strip_model_->ActivateTabAt(index);
+      return;
+    }
+  }
+
+  content::WebContents& contents =
+      chrome::NewTab(browser_, NewTabTypes::kNoUserAction);
+  ZeniumSpaceTabData::SetSpaceId(&contents, active_space_id_);
+}
+
+bool ZeniumSpaceController::HasSpace(const std::string& space_id) const {
+  return std::ranges::find(spaces_, space_id, &Space::id) != spaces_.end();
+}
+
+std::string ZeniumSpaceController::SpaceIdForTab(
+    const TabInterface* tab) const {
+  return tab ? ZeniumSpaceTabData::GetSpaceId(tab->GetContents())
+             : std::string();
+}
+
+void ZeniumSpaceController::NotifyChanged() {
+  changed_callbacks_.Notify();
+}
+
+}  // namespace tabs
