+void TabStripView::SetZeniumSpaceController(
+    tabs::ZeniumSpaceController* space_controller) {
+  space_changed_subscription_ = {};
+  space_controller_ = space_controller;
+  if (!space_controller_) {
+    return;
+  }
+  space_changed_subscription_ =
+      space_controller_->RegisterChangedCallback(base::BindRepeating(
+          &TabStripView::UpdateZeniumSpaceVisibility,
+          base::Unretained(this)));
+  UpdateZeniumSpaceVisibility();
+}
+
+void TabStripView::UpdateZeniumSpaceVisibility() {
+  if (!collection_node_ || !space_controller_ ||
+      !space_controller_->tab_strip_model()) {
+    return;
+  }
+
+  TabStripModel* model = space_controller_->tab_strip_model();
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(index);
+    if (TabCollectionNode* node =
+            collection_node_->GetNodeForHandle(tab->GetHandle())) {
+      node->view()->SetVisible(space_controller_->IsTabVisible(tab));
+    }
+  }
+
+  UpdateNodeVisibility(collection_node_);
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
+
+bool TabStripView::UpdateNodeVisibility(TabCollectionNode* node) {
+  if (node->type() == TabCollectionNode::Type::TAB) {
+    return node->view()->GetVisible();
+  }
+
+  bool any_child_visible = false;
+  for (const auto& child : node->children()) {
+    any_child_visible |= UpdateNodeVisibility(child.get());
+  }
+
+  if (node != collection_node_ &&
+      node->type() != TabCollectionNode::Type::PINNED) {
+    node->view()->SetVisible(any_child_visible);
+  }
+  return any_child_visible;
+}
