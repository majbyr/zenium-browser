+      std::string space_id)
+      : controller_(std::move(controller)), space_id_(std::move(space_id)) {}
+
+  void Accept() {
+    if (controller_) {
+      controller_->RenameSpace(
+          space_id_,
+          dialog_model()->GetTextfieldByUniqueId(kRenameSpaceFieldId)->text());
+    }
+  }
+
+ private:
+  base::WeakPtr<tabs::ZeniumSpaceController> controller_;
+  std::string space_id_;
+};
+
+}  // namespace
+
+ZeniumSpaceSwitcher::ZeniumSpaceSwitcher(
+    tabs::ZeniumSpaceController* controller)
+    : controller_(controller) {
+  SetMainAxisAlignment(views::LayoutAlignment::kCenter);
+  SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+  SetOrientation(views::LayoutOrientation::kHorizontal);
+  changed_subscription_ =
+      controller_->RegisterChangedCallback(base::BindRepeating(
+          &ZeniumSpaceSwitcher::Rebuild, base::Unretained(this)));
+  Rebuild();
+}
+
+ZeniumSpaceSwitcher::~ZeniumSpaceSwitcher() = default;
+
+void ZeniumSpaceSwitcher::ClearController() {
+  changed_subscription_ = {};
+  controller_ = nullptr;
+  context_anchor_ = nullptr;
+  button_space_ids_.clear();
+}
+
+void ZeniumSpaceSwitcher::SetCollapsed(bool collapsed) {
+  if (collapsed_ == collapsed) {
+    return;
+  }
+  collapsed_ = collapsed;
+  SetOrientation(collapsed ? views::LayoutOrientation::kVertical
+                           : views::LayoutOrientation::kHorizontal);
+  Rebuild();
+}
+
+void ZeniumSpaceSwitcher::ShowContextMenuForViewImpl(
+    View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto it = button_space_ids_.find(source);
+  if (it == button_space_ids_.end()) {
+    return;
+  }
+  context_space_id_ = it->second;
+  context_anchor_ = source;
+
+  context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  context_menu_model_->AddItem(kRenameSpace, u"Rename Space…");
+  context_menu_model_->AddItem(kMoveCurrentTab, u"Move Current Tab Here");
+  context_menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  context_menu_model_->AddItem(kDeleteSpace, u"Delete Space");
+  context_menu_runner_ = std::make_unique<views::MenuRunner>(
+      context_menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  context_menu_runner_->RunMenuAt(
+      source->GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+      views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void ZeniumSpaceSwitcher::ExecuteCommand(int command_id, int event_flags) {
+  views::View* const anchor = context_anchor_;
+  context_anchor_ = nullptr;
+  switch (command_id) {
+    case kRenameSpace:
+      ShowRenameBubble(anchor, context_space_id_);
+      break;
+    case kMoveCurrentTab:
+      controller_->MoveTabToSpace(
+          controller_->tab_strip_model()->GetActiveTab(), context_space_id_);
+      break;
+    case kDeleteSpace:
+      controller_->DeleteSpace(context_space_id_);
+      break;
+  }
+}
+
+bool ZeniumSpaceSwitcher::IsCommandIdEnabled(int command_id) const {
+  if (command_id == kDeleteSpace) {
+    return controller_->spaces().size() > 1;
+  }
+  if (command_id == kMoveCurrentTab) {
+    tabs::TabInterface* tab = controller_->tab_strip_model()->GetActiveTab();
+    return tab && !tab->IsPinned();
+  }
+  return true;
+}
+
+void ZeniumSpaceSwitcher::Rebuild() {
+  context_anchor_ = nullptr;
+  button_space_ids_.clear();
+  RemoveAllChildViews();
+
+  // Zen only shows the workspace indicator when there is somewhere to switch,
+  // but the switcher itself remains in the footer to keep the controls at the
+  // two edges. This also prevents the footer from jumping when the second Space
+  // is created.
+  if (controller_->spaces().size() > 1) {
+    for (const auto& space : controller_->spaces()) {
+      const bool active = space.id == controller_->active_space_id();
+      auto button = std::make_unique<views::LabelButton>(
+          base::BindRepeating(
+              [](base::WeakPtr<tabs::ZeniumSpaceController> controller,
+                 std::string space_id, const ui::Event&) {
+                if (controller) {
+                  controller->SwitchToSpace(space_id);
+                }
+              },
+              controller_->GetWeakPtr(), space.id),
+          active ? u"●" : u"•");
+      button->SetPreferredSize(gfx::Size(kSpaceButtonSize, kSpaceButtonSize));
+      button->SetBorder(views::CreateEmptyBorder(gfx::Insets()));
+      button->SetTooltipText(space.name);
+      button->GetViewAccessibility().SetName(space.name);
+      button->SetEnabledTextColors(active ? kColorToolbarButtonIcon
+                                          : kColorToolbarButtonIconInactive);
+      button->set_context_menu_controller(this);
+      views::LabelButton* button_ptr = AddChildView(std::move(button));
+      button_space_ids_.emplace(button_ptr, space.id);
+    }
+  }
+
+  SetVisible(true);
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
+
+void ZeniumSpaceSwitcher::ShowRenameBubble(views::View* anchor,
+                                           const std::string& space_id) {
+  auto it = std::ranges::find(controller_->spaces(), space_id,
+                              &tabs::ZeniumSpaceController::Space::id);
+  if (!anchor || it == controller_->spaces().end()) {
+    return;
+  }
+
+  auto delegate = std::make_unique<RenameSpaceDialogDelegate>(
+      controller_->GetWeakPtr(), space_id);
+  auto* delegate_ptr = delegate.get();
+  auto dialog_model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(u"Rename Space")
+          .AddTextfield(kRenameSpaceFieldId, std::u16string(), it->name)
+          .AddOkButton(base::BindOnce(&RenameSpaceDialogDelegate::Accept,
+                                      base::Unretained(delegate_ptr)))
+          .AddCancelButton(base::DoNothing())
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(dialog_model), anchor, views::BubbleBorder::BOTTOM_CENTER);
+  views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+      ->Show();
+}
